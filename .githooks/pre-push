#!/bin/sh
# Release tags follow semantic versioning: the tag is the version with a `v`
# prefix, `vX.Y.Z`. A dash suffix marks a pre-release, `vX.Y.Z-rc.1`.
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Branch pushes pass through untouched. Only tag names are checked here; the
# release workflow checks again that the tag matches the Cargo.toml version.
set -eu

pattern='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/tags/*) ;;
        *) continue ;;
    esac

    tag="${local_ref#refs/tags/}"
    if ! printf '%s\n' "$tag" | grep -Eq "$pattern"; then
        echo "error: refusing to push tag '$tag': release tags are vX.Y.Z" >&2
        status=1
    fi
done

exit "$status"
